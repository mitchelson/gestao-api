NODE_ENV=development
PORT=3060
HOST=127.0.0.1

# Túnel SSH: ssh -L 5433:127.0.0.1:5433 root@31.97.169.130
DATABASE_URL=postgresql://pibrr_gestao:CHANGE_ME@127.0.0.1:5433/pibrr_gestao

AUTH_JWT_SECRET=change-me-in-production
AUTH_MOBILE_SECRET=
GOOGLE_CLIENT_IDS=
AUTH_GOOGLE_ID=
APPLE_CLIENT_ID=
APPLE_BUNDLE_ID=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=

CORS_ORIGINS=http://localhost:3000,exp://localhost:8081
TRUST_PROXY=false
LOG_LEVEL=info

# Push (opcional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@pibrr.com

# Upload local
UPLOAD_DIR=/tmp/gestao-api-uploads
# URL pública absoluta dos arquivos (app precisa de URL completa)
UPLOAD_BASE_URL=https://gestao-api.pibrr.com/uploads
PUBLIC_API_URL=https://gestao-api.pibrr.com

# YouTube proxy (opcional)
YOUTUBE_API_KEY=

# Feature flags
FEATURE_USE_NEW_PERMISSIONS=false
